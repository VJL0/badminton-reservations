# Copy to .env.local for development. In production set these in Vercel. Public (NEXT_PUBLIC_*) vars are inlined at build time, so redeploy after changing them.

# Supabase — Project Settings → API Keys (local: `pnpm supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY= # server-only; lets admins add admins and reset passwords from /admin; leave unset to disable

# Turnstile CAPTCHA — leave empty for local dev; in production also enable CAPTCHA protection in Supabase Auth, or anyone can mass-create anonymous players
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Web Push ("you're up next" / "you're on court N" alerts) — all optional, app works without them; generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY= # server-only
VAPID_SUBJECT=mailto:you@example.com
PUSH_WEBHOOK_SECRET= # shared secret the database sends with each push request; long and random; also needs SUPABASE_SECRET_KEY and vault.create_secret('https://<domain>/api/push', 'push_url'/'push_secret')
