# Copy to .env.local for development. In production set these in Vercel. Public (NEXT_PUBLIC_*) vars are inlined at build time, so redeploy after changing them.

# Supabase — Project Settings → API Keys (local: `pnpm supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY= # server-only, required: staff-privileged actions run as this role (see below)

# Staff sign-in: one shared code, never stored in plaintext.
# 1. Pick a code. 2. `node scripts/hash-staff-code.mjs "<code>"`. 3. Paste the output below.
STAFF_ACCESS_CODE_HASH= # server-only
STAFF_SESSION_SECRET= # server-only; random string that signs the staff session cookie, e.g. `openssl rand -hex 32`

# Turnstile CAPTCHA — leave empty for local dev; in production also enable CAPTCHA protection in Supabase Auth, or anyone can mass-create anonymous players
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Web Push ("you're up next" / "you're on court N" alerts) — all optional, app works without them; generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY= # server-only
VAPID_SUBJECT=mailto:you@example.com
PUSH_WEBHOOK_SECRET= # shared secret the database sends with each push request; long and random; also needs SUPABASE_SECRET_KEY (already required above) and vault.create_secret('https://<domain>/api/push', 'push_url'/'push_secret')
