# Copy to .env.local for development. In production set these in Vercel (Project → Settings → Environment Variables).
# All three are public (NEXT_PUBLIC_*) and are inlined at build time, so redeploy after changing them.

# Supabase → Project Settings → API. Local: `pnpm supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The publishable (anon) key. Never put the service-role / secret key in this app.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile *site* key. Leave empty only for local development.
# In production set it AND turn on CAPTCHA protection in Supabase Auth (with the Turnstile *secret*),
# otherwise anyone can mass-create anonymous players.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only (never NEXT_PUBLIC_*). Lets admins add other admins and reset their passwords from /admin.
# Supabase → Project Settings → API → secret / service_role key. Local: `pnpm supabase status`.
# Leave unset to disable that feature.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push ("you're up next" / "you're on court N" alerts). All optional: without them the app works, minus push.
# Generate a key pair once: `npx web-push generate-vapid-keys`. The public key is inlined at build time.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only. Never NEXT_PUBLIC_*.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret the database sends with each push request. Long and random.
PUSH_WEBHOOK_SECRET=
# The push route also needs SUPABASE_SERVICE_ROLE_KEY (above), and the database must be told where to call:
#   select vault.create_secret('https://<your-domain>/api/push', 'push_url');
#   select vault.create_secret('<same value as PUSH_WEBHOOK_SECRET>', 'push_secret');
