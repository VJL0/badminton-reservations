# Copy to .env.local for development. In production set these in Vercel (Project → Settings → Environment Variables).
# The NEXT_PUBLIC_* values are public and are inlined at build time, so redeploy after changing them.

# Supabase → Project Settings → API. Local: `pnpm supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# The publishable key (sb_publishable_…). Never put the secret key in this app's public variables.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile *site* key. Leave empty only for local development.
# In production set it AND turn on CAPTCHA protection in Supabase Auth (with the Turnstile *secret*),
# otherwise anyone can mass-create anonymous players.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---- Server-only (never NEXT_PUBLIC_*) ----

# The one address this app is known by: the printed join QR, invitation and password-reset links. Origin only, no path.
# Required in production; on Vercel it falls back to the project's production domain. It is never taken from
# request headers, so a preview deployment cannot change what gets printed and emailed.
APP_URL=http://127.0.0.1:3000

# Supabase → Project Settings → API → secret key (sb_secret_…). Local: `pnpm supabase status` (SECRET_KEY).
# Lets admins invite other admins from /admin and runs the push worker. It only ever calls the few database
# functions granted to the service role, never tables. Leave unset to switch those features off.
# (The legacy SUPABASE_SERVICE_ROLE_KEY is still read if this is not set.)
SUPABASE_SECRET_KEY=

# Web Push ("you're up next" / "you're on court N" alerts). All optional: without them the app works, minus push.
# Generate a key pair once: `npx web-push generate-vapid-keys`. The public key is inlined at build time.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Shared secret the database sends when it wakes the push worker (POST /api/push). Long and random.
PUSH_WEBHOOK_SECRET=
# The push worker also needs SUPABASE_SECRET_KEY (above), and the database must be told where to call:
#   select vault.create_secret('https://<your-domain>/api/push', 'push_url');
#   select vault.create_secret('<same value as PUSH_WEBHOOK_SECRET>', 'push_secret');
