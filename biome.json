{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!.next", "!next-env.d.ts", "!src/lib/supabase/database.types.ts", "!supabase", "!public"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "css": { "formatter": { "enabled": false }, "parser": { "tailwindDirectives": true } },
  "linter": {
    "domains": { "next": "recommended", "react": "recommended", "project": "recommended" },
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["Switch", "Input"], "labelComponents": ["Label", "FieldLabel"] }
        }
      },
      "nursery": {
        "useReactCompiler": "error",
        "noFloatingPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": { "useSemanticElements": "off", "noLabelWithoutControl": "off" },
          "suspicious": { "noDoubleEquals": "off", "noArrayIndexKey": "off" }
        }
      }
    }
  ]
}
